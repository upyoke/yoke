/* Single stylesheet for the full-screen `yoke setup` wizard.
   Palette is defined once here; widgets reference these variables and toggle
   classes rather than hardcoding colors. */

$onboard-accent: #f4a261;
$onboard-accent-bright: #f4a261;
$onboard-brand: #f4a261;
$onboard-danger: #f85149;
$onboard-text: #dfe6ec;
$onboard-dim: #8995a1;
$onboard-row-bg: #171c22;
$onboard-rule: #262e37;

Screen {
    background: #101418;
    color: $onboard-text;
    layout: vertical;
}

/* ── Header ─────────────────────────────────────────────── */
#onboard-header {
    height: auto;
    padding: 0 3;
    margin: 1 0 0 0;
}

/* ── Stepper ────────────────────────────────────────────── */
#onboard-stepper {
    height: auto;
    padding: 0 3;
    margin: 1 0 0 0;
}

.onboard-divider {
    height: 1;
    color: $onboard-rule;
    margin: 0;
    padding: 0 3;
}

/* ── Body ───────────────────────────────────────────────── */
/* The body holds the active SelectionList/Input, which the shell focuses on
   every swap. The selected row shows focus on its own via
   _OptionRow.-selected, so the body needs no focus border. */
#onboard-body {
    height: 1fr;
    padding: 1 3 0 3;
}

/* The scrollbar is drawn with partial-block glyphs, which a screen/dumb
   terminal cannot show; the body still scrolls from the keyboard there. */
Screen.plain-glyphs #onboard-body {
    scrollbar-size-vertical: 0;
}

.onboard-title {
    height: auto;
    text-style: bold;
    color: $onboard-text;
}

/* Error headline: same bold weight as a title, in the danger color, paired with
   a leading ✗ glyph in screen-building code. Auto height/1fr width so a long
   error title wraps instead of clipping on a narrow terminal. */
.onboard-title-error {
    height: auto;
    width: 1fr;
    text-style: bold;
    color: $onboard-danger;
}

.onboard-subtitle {
    height: auto;
    width: 1fr;
    color: $onboard-dim;
}

.onboard-spacer {
    height: 1;
}

.onboard-note {
    color: $onboard-dim;
    margin: 1 0 0 0;
}

/* ── Board art ──────────────────────────────────────────── */
/* Rendered art keeps its natural size: figlet rows and the emoji master map
   must not wrap or shrink, so the block keeps its own width/height and scrolls
   horizontally inside the body when a wide header or long word overruns it. */
.onboard-art {
    height: auto;
    width: auto;
    margin: 1 0 0 0;
    overflow-x: auto;
}

/* ── Selection list ─────────────────────────────────────── */
SelectionList {
    height: auto;
    padding: 0 3 0 0;
}

.onboard-search-status {
    height: auto;
    color: $onboard-dim;
    margin: 0 0 1 1;
}

.onboard-selection-detail {
    height: auto;
    width: 1fr;
    color: $onboard-text;
    margin: 1 3 0 2;
}

_OptionRow {
    height: auto;
    width: 1fr;
    color: $onboard-dim;
    border-left: blank;
    padding: 0 0 0 1;
}

_OptionRow.-selected {
    color: $onboard-accent-bright;
    text-style: bold;
    background: $onboard-row-bg;
    /* "heavy" draws a vertical line glyph (┃). "thick" draws a solid block
       (█) on a height-1 row, which is indistinguishable from a text cursor
       in an exported screenshot — it read as one until an operator asked. */
    border-left: heavy $onboard-accent;
    padding: 0;
}

Screen.plain-glyphs _OptionRow.-selected {
    border-left: blank;
    padding: 0 0 0 1;
}

/* ── Input screen ───────────────────────────────────────── */
/* Styled by class, not by id: a screen that collects several values needs one
   box per field, and each of those needs its own id to address it. */
.onboard-input {
    height: auto;
    margin: 1 3 0 0;
    border: solid $onboard-accent;
    background: transparent;
}

.onboard-input:focus {
    border: solid $onboard-accent-bright;
}

.onboard-input-error {
    color: $onboard-danger;
    height: auto;
    margin: 1 0 0 0;
}

/* ── Multi-field screen ─────────────────────────────────── */
/* A field box sits directly under its own label at the body's text indent and
   keeps a fixed width, so a pair of them reads as one credential rather than as
   two full-width screens stacked. */
.onboard-form-input {
    width: 54;
    max-width: 100%;
    margin: 0 0 0 2;
}

/* The inline error slot takes no row until it has something to say, so a screen
   that fills its frame exactly still fits while it is being filled in. */
.onboard-field-error {
    color: $onboard-danger;
    height: auto;
    margin: 0 0 0 2;
    display: none;
}

.onboard-field-error.-shown {
    display: block;
}

/* ── Write plan ─────────────────────────────────────────── */
.onboard-plan-group-machine {
    color: $onboard-accent-bright;
    text-style: bold;
    margin: 1 0 0 0;
}

.onboard-plan-group-core,
.onboard-plan-group-control {
    color: #a5d8ff;
    text-style: bold;
    margin: 1 0 0 0;
}

.onboard-plan-group-repo {
    color: #d29922;
    text-style: bold;
    margin: 1 0 0 0;
}

.onboard-plan-group-source {
    color: #db61a2;
    text-style: bold;
    margin: 1 0 0 0;
}

.onboard-plan-line {
    color: $onboard-text;
    /* Wrap long lines instead of clipping them at the window edge: auto height
       lets a line grow to as many rows as the wrapped text needs, and width 1fr
       binds the wrap point to the body width so it re-flows on resize. The
       detail/message/plan lines (repo lists, the publish-capability sentence)
       routinely exceed one row on a narrow terminal. */
    height: auto;
    width: 1fr;
}

/* ── Footer ─────────────────────────────────────────────── */
#onboard-footer {
    height: auto;
    color: $onboard-dim;
    padding: 0 3;
    margin: 0 0 1 0;
    dock: bottom;
}
