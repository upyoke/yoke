{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate SessionStart'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate UserPromptSubmit'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate PreToolUse'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      },
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate PreToolUse'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate PreToolUse'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate PostToolUse'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      },
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate PostToolUse'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'PATH=\"${XDG_BIN_HOME:-$HOME/.local/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; export PATH; env YOKE_ROOT=\"${YOKE_ROOT:-$PWD}\" YOKE_EXECUTOR=codex YOKE_PROVIDER=openai yoke hook evaluate Stop'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ]
  }
}
