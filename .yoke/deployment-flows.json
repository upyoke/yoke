{
  "schema": 4,
  "default_flow": "yoke-internal",
  "retire_if_present": [
    "yoke-hosted-production",
    "yoke-hosted-production-hotfix",
    "yoke-hosted-stage",
    "yoke-hosted-production-hotfix-no-ci-gate",
    "yoke-hosted-stage-no-ci-gate",
    "yoke-hosted-production-hotfix-warm-gated",
    "yoke-hosted-production-hotfix-typed-target",
    "yoke-hosted-stage-warm-gated",
    "yoke-hosted-stage-typed-target",
    "yoke-hosted-stage-consumer-bound"
  ],
  "flows": [
    {
      "id": "yoke-internal",
      "name": "Internal",
      "description": "Script/doc changes, no deployment needed",
      "stages": [
        {
          "name": "merged",
          "step_runner": "auto"
        },
        {
          "name": "complete",
          "step_runner": "auto"
        }
      ],
      "on_failure": "halt",
      "done_description": "Merged to main",
      "status": "active",
      "target_tier": null
    },
    {
      "id": "yoke-hosted-prod-hotfix-typed-target",
      "name": "Prod Hotfix (Warm-Gated, No CI Gate, Typed Target)",
      "description": "Dispatch an annotated Yoke hotfix through the Platform prod train without waiting for repository CI, then warm the rolled prod box before reporting success",
      "stages": [
        {
          "name": "merged",
          "step_runner": "auto"
        },
        {
          "name": "hosted-release",
          "step_runner": "github-actions-workflow",
          "workflow": "platform-release-bridge.yml",
          "dispatch_correlation_input": "yoke_dispatch_id",
          "ref": "main",
          "inputs": {
            "target_environment": "{target_environment}",
            "release_mode": "hotfix",
            "product_sha": "{head_sha}",
            "deployment_run_id": "{run_id}"
          },
          "reconcile_by_head_sha": false,
          "wait_for_ci": false
        },
        {
          "name": "warm-up",
          "step_runner": "warm-up"
        },
        {
          "name": "complete",
          "step_runner": "auto"
        }
      ],
      "on_failure": "halt",
      "done_description": "Yoke hotfix completed through the hosted prod train",
      "status": "active",
      "target_tier": "persistent",
      "environment": "prod"
    },
    {
      "id": "yoke-hosted-stage-release-qa",
      "name": "Stage Release with Item QA",
      "description": "Publish the candidate to stage and admit only members owing stage-targeted post-deploy proof",
      "stages": [
        {
          "name": "merged",
          "step_runner": "auto",
          "stage_kind": "execution"
        },
        {
          "name": "hosted-release",
          "step_runner": "github-actions-workflow",
          "workflow": "platform-release-bridge.yml",
          "dispatch_correlation_input": "yoke_dispatch_id",
          "ref": "main",
          "inputs": {
            "target_environment": "{target_environment}",
            "release_mode": "normal",
            "product_sha": "{head_sha}",
            "deployment_run_id": "{run_id}",
            "consumer_sha": "{consumer_sha}"
          },
          "reconcile_by_head_sha": false,
          "wait_for_ci": false,
          "stage_kind": "execution",
          "input_bindings": {
            "consumer_sha": {
              "project": "platform",
              "branch": "main"
            }
          }
        },
        {
          "name": "warm-up",
          "step_runner": "warm-up",
          "stage_kind": "execution",
          "connection_env": "stage"
        },
        {
          "name": "item-qa",
          "step_runner": "qa",
          "stage_kind": "qa",
          "scope": "item",
          "target": {
            "kind": "persistent_environment",
            "environment": "stage",
            "source_stage": "hosted-release"
          },
          "verdict": {
            "mode": "agent_only"
          }
        },
        {
          "name": "complete",
          "step_runner": "auto",
          "stage_kind": "execution"
        }
      ],
      "on_failure": "halt",
      "done_description": "Yoke release completed through the hosted stage train",
      "status": "active",
      "target_tier": "persistent",
      "environment": "stage",
      "takes_delivery_custody": true
    },
    {
      "id": "yoke-branch-preview",
      "name": "Branch Preview",
      "description": "Deploy an unmerged Yoke branch to its configured preview host",
      "stages": [
        {
          "name": "ephemeral-deploy",
          "step_runner": "ephemeral-deploy"
        },
        {
          "name": "complete",
          "step_runner": "auto"
        }
      ],
      "on_failure": "halt",
      "done_description": "Yoke branch preview deployed",
      "status": "active",
      "target_tier": "ephemeral"
    }
  ]
}
