# Yoke-managed ignore policy for the .yoke/ tree (seeded by
# `yoke project install`). Generated views and machine-local
# state never track; every other contract file rides the repo.
# Projects need no root-gitignore `.yoke/*` rules.
BOARD.md
BOARD.md.ts
BOARD.md.lock/
BOARD.md.board.*
BOARD.md.reg_*
backups/
strategy/
!/docs/strategy/
.github-retry.log
.merge-lock
install-manifest.json
install-pending.json
tmp/
# Yoke source checkout only: generated views of docs/public and
# runtime/harness/*/manifest.json (yoke_contracts.project_contract.source_installed_views).
/docs/
/harness/
